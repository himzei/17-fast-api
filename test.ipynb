   "source": [
    "from pathlib import Path\n",
    "import shutil\n",
    "\n",
    "root = Path(\".\")  # 현재 폴더\n",
    "\n",
    "for git_dir in root.rglob(\".git\"):\n",
    "    if git_dir.is_dir():\n",
    "        print(f\"삭제: {git_dir}\")\n",
    "        shutil.rmtree(git_dir)\n",
    "\n",
    "print(\"모든 .git 폴더 삭제 완료\")"
   ]
  },
